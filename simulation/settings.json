{
    "device": "PI2",
    "device_map": {
        "PI1": {
            "sensors": [
                "DS1",
                "DUS1",
                "DPIR1",
                "DMS"
            ],
            "actuators": [
                "DL",
                "DB"
            ]
        },
        "PI2": {
            "sensors": [
                "DS2",
                "DUS2",
                "DPIR2",
                "4SD",
                "BTN",
                "DHT3",
                "GSG"
            ],
            "actuators": []
        },
        "PI3": {
            "sensors": [
                "DHT1",
                "DHT2",
                "IR",
                "DPIR3"
            ],
            "actuators": [
                "BRGB",
                "LCD"
            ]
        }
    },
    "hardware": {
        "DS1": {
            "pin": 22,
            "simulated": true,
            "interval": 1,
            "debounce_ms": 100,
            "simulator": {
                "toggle_probability": 0.3,
                "initial_state": 0
            }
        },
        "DUS1": {
            "trigger_pin": 23,
            "echo_pin": 24,
            "simulated": true,
            "interval": 5,
            "simulator": {
                "initial_distance": 80.0,
                "min_distance": 2.0,
                "max_distance": 120.0,
                "step": 5
            }
        },
        "DL": {
            "pin": 25,
            "simulated": true,
            "active_high": true
        },
        "DB": {
            "pin": 12,
            "simulated": true,
            "active_high": true,
            "pwm": false,
            "frequency": 2000,
            "duty_cycle": 50,
            "short_duration": 0.1,
            "long_duration": 0.5
        },
        "DPIR1": {
            "pin": 27,
            "simulated": true,
            "interval": 3,
            "simulator": {
                "quiet_range": [
                    3,
                    10
                ],
                "burst_range": [
                    2,
                    6
                ]
            }
        },
        "DMS": {
            "row_pins": [
                5,
                6,
                13,
                19
            ],
            "col_pins": [
                16,
                20,
                21,
                26
            ],
            "simulated": true,
            "pin_code": "5279",
            "auto_delay": 2,
            "key_delay": 0.15
        },

        "DS2": {
            "pin": 5,
            "simulated": true,
            "interval": 1,
            "debounce_ms": 100,
            "simulator": {
                "toggle_probability": 0.3,
                "initial_state": 0
            }
        },
        "DUS2": {
            "trigger_pin": 6,
            "echo_pin": 13,
            "simulated": true,
            "interval": 5,
            "simulator": {
                "initial_distance": 0.0,
                "min_distance": 2.0,
                "max_distance": 120.0,
                "step": 5
            }
        },
        "DPIR2": {
            "pin": 19,
            "simulated": true,
            "interval": 3,
            "simulator": {
                "quiet_range": [
                    3,
                    10
                ],
                "burst_range": [
                    2,
                    6
                ]
            }
        },
        "BTN": {
            "pin": 26,
            "simulated": true,
            "debounce_ms": 100,
            "interval": 0.01
        },
        "DHT3": {
            "pin": 17,
            "simulated": true,
            "interval": 2,
            "simulator": {
                "initial_temp": 25,
                "initial_humidity": 20,
                "step": 1
            }
        },
        "GSG": {
            "sda_pin": 2,
            "scl_pin": 3,
            "interval": 1,
            "simulated": true,
            "simulator": {
                
            }
        },
        "4SD": {
            "segment_pins": [4, 7, 8, 9, 10, 11, 14, 15],
            "digit_pins": [18, 22, 23, 24],
            "simulated": true
        },

        "DHT1": {
            "pin": 22,
            "simulated": true,
            "interval": 2,
            "simulator": {
                "initial_temp": 25,
                "initial_humidity": 20,
                "step": 1
            }
        },
        "DHT2": {
            "pin": 23,
            "simulated": true,
            "interval": 2,
            "simulator": {
                "initial_temp": 25,
                "initial_humidity": 20,
                "step": 1
            }
        },
        "IR": {
            "pin": 17,
            "simulated": true,
            "rgb_led_code": "BRGB"
        },
        "BRGB": {
            "red_pin": 5,
            "green_pin": 6,
            "blue_pin": 13,
            "simulated": true
        },
        "LCD": {
            "readings_cycle_seconds": 5,
            "dht_codes": ["DHT1", "DHT2", "DHT3"],
            "measurement_codes": ["temperature", "humidity"],
            "simulated": true
        },
        "DPIR3": {
            "pin": 27,
            "simulated": true,
            "interval": 3,
            "simulator": {
                "quiet_range": [
                    3,
                    10
                ],
                "burst_range": [
                    2,
                    6
                ]
            }
        }
    },
    "mqtt": {
        "host": "localhost",
        "port": 1883,
        "base_topic": "smarthome",
        "command_base_topic": "smarthome/commands",
        "publish_batch_size": 10,
        "publish_flush_interval": 2.0
    },
    "door_logic": {
        "enabled": true,
        "codes": {
            "ds": "DS1",
            "dpir": "DPIR1",
            "dus": "DUS1",
            "dms": "DMS",
            "dl": "DL",
            "db": "DB"
        },
        "presence_distance_cm": 70,
        "distance_stale_seconds": 5,
        "presence_light_seconds": 10,
        "unlock_light_seconds": 8,
        "door_open_alert_seconds": 15,
        "door_open_beep_interval": 5,
        "door_open_blink_interval": 0.5,
        "failure_beep_pause_seconds": 0.15,
        "coordinator_interval": 0.2,
        "key_beep": "short",
        "success_beep": "long",
        "failure_beep": "double_short",
        "door_open_beep": "short"
    }
}
