        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "from(bucket: \"smart_home_bucket\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"membrane_key\")\n  |> filter(fn: (r) => r._field == \"value\")\n  |> filter(fn: (r) => r.code == \"DMS\")\n  |> aggregateWindow(every: 100ms, fn: last, createEmpty: false)",
          "refId": "A"
        }
      ],
      "title": "Membrane Key Presses (DMS)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "influxdb",
